{
  "name": "hybridframework-playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:allure": "powershell Remove-Item -Recurse -Force .\\allure-results\\*",
    "allure:generate": "npx allure-commandline generate allure-results --clean -o allure-report",
    "allure:open": "npx allure-commandline open allure-report",
    "test:all": "npx playwright test",
    "test:api": "npx playwright test --project=\"API Tests\"",
    "test:web": "npx playwright test --project=chromium --project=firefox",
    "test:mobile": "npx playwright test --project=\"Mobile Chrome\""
    ,"auth:generate": "node scripts/generateAuthState.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^24.0.10",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "dotenv": "^17.0.1"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0"
  }
}
